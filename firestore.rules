rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /*
     * ============================================================
     * HELPERS GENERAUX
     * ============================================================
     */

    function signedIn() {
      return request.auth != null;
    }

    function hasAuthLink() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/user-auth/$(request.auth.uid)
        );
    }

    function authLink() {
      return get(
        /databases/$(database)/documents/user-auth/$(request.auth.uid)
      );
    }

    function currentUserId() {
      return authLink().data.userId;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(currentUserId())
      );
    }

    function hasActiveProfile() {
      return hasAuthLink()
        && currentUser().data.status == "ACTIVE"
        && currentUser().data.accountActivated == true;
    }


    /*
     * ============================================================
     * ROLES
     * ============================================================
     */

    function isAdmin() {
      return hasActiveProfile()
        && currentUser().data.roles.administrator == true;
    }

    function isManager() {
      return hasActiveProfile()
        && currentUser().data.roles.manager == true;
    }

    function isPlayer() {
      return hasActiveProfile()
        && currentUser().data.roles.player == true;
    }

    function isAdminOrManager() {
      return isAdmin()
        || isManager();
    }


    /*
     * ============================================================
     * ETABLISSEMENTS
     * ============================================================
     */

    function managesVenue(venueId) {
      return isManager()
        && currentUserId() in get(
          /databases/$(database)/documents/venues/$(venueId)
        ).data.managerUserIds;
    }

    function canManageVenue(venueId) {
      return isAdmin()
        || managesVenue(venueId);
    }


    /*
     * ============================================================
     * MATCH / REGISTRATION HELPERS
     * ============================================================
     */

    function matchDocument(matchId) {
      return get(
        /databases/$(database)/documents/matches/$(matchId)
      );
    }

    function registrationDocument(registrationId) {
      return get(
        /databases/$(database)/documents/registrations/$(registrationId)
      );
    }

    /*
     * Un membre autorisé d'une inscription est :
     *
     * - son capitaine
     * OU
     * - un joueur présent dans playerIds.
     *
     * Le capitaine peut donc jouer ou ne pas jouer.
     */
    function isRegistrationMember(registrationId) {

      let registration =
        registrationDocument(registrationId);

      return registration.data.captainId == currentUserId()
        || currentUserId() in registration.data.playerIds;
    }

    /*
     * L'utilisateur peut planifier le match s'il appartient
     * à l'inscription domicile OU à l'inscription extérieure.
     */
    function canPlanMatch(matchId) {

        let matchDoc =
            matchDocument(matchId);

        return isRegistrationMember(
            matchDoc.data.homeRegistrationId
        )
        || isRegistrationMember(
            matchDoc.data.awayRegistrationId
        );
    }


    /*
     * ============================================================
     * ACTIVATION DE COMPTE
     * ============================================================
     */

    function isActivationProfile(userId) {
      return signedIn()
        && !hasAuthLink()
        && resource.data.accountActivated == false
        && resource.data.firebaseUid == null
        && resource.data.status == "ACTIVE"
        && exists(
          /databases/$(database)/documents/activation-licenses/$(resource.data.licenseNumber)
        )
        && get(
          /databases/$(database)/documents/activation-licenses/$(resource.data.licenseNumber)
        ).data.userId == userId;
    }


    /*
     * ============================================================
     * ACTIVATION-LICENSES
     * ============================================================
     */

    match /activation-licenses/{licenseNumber} {

  /*
   * ------------------------------------------------------------
   * Lecture pendant l'activation
   * ------------------------------------------------------------
   *
   * Un utilisateur Firebase vient d'être créé,
   * mais user-auth n'existe pas encore.
   */

  allow get:
    if signedIn();


  /*
   * L'énumération complète des licences
   * est réservée aux administrateurs.
   */
  allow list:
    if isAdmin();


  /*
   * ------------------------------------------------------------
   * Création par l'administrateur
   * ------------------------------------------------------------
   */

  allow create:
    if isAdmin()

    && request.resource.data.keys().hasOnly([
      "userId"
    ])

    && request.resource.data.userId is string

    /*
     * Le users/<userId> créé dans le même batch
     * doit réellement correspondre à cette licence.
     */
    && getAfter(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    ).data.licenseNumber
      == licenseNumber;


  /*
   * Pas encore de modification de licence dans PR-142.
   *
   * On pourra introduire une opération métier atomique
   * dédiée si on décide de permettre le changement
   * d'un numéro de licence.
   */
  allow update:
    if false;


  /*
   * Pas de suppression physique depuis l'application
   * pour le moment.
   */
  allow delete:
    if false;

}


    match /user-auth/{firebaseUid} {

  /*
   * ------------------------------------------------------------
   * Lecture
   * ------------------------------------------------------------
   *
   * - utilisateur connecté : son propre mapping
   * - administrateur : tous les mappings
   */

  allow get:
    if signedIn()
    && (
      request.auth.uid == firebaseUid
      || isAdmin()
    );

  allow list:
    if isAdmin();


  /*
   * ------------------------------------------------------------
   * Création pendant l'activation
   * ------------------------------------------------------------
   *
   * Un utilisateur peut uniquement créer :
   *
   * user-auth/<son Firebase UID>
   *
   * avec uniquement :
   *
   * {
   *   userId: "..."
   * }
   */

  allow create:
    if signedIn()

    && request.auth.uid == firebaseUid

    && request.resource.data.keys().hasOnly([
      "userId"
    ])

    && request.resource.data.userId is string

    /*
     * Le profil métier ciblé doit exister.
     */
    && exists(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    )

    /*
     * Le profil doit maintenant être lié
     * au Firebase UID connecté.
     *
     * Comme activateUser() effectue les deux
     * opérations dans un batch, getAfter()
     * permet de voir l'état final du profil.
     */
    && getAfter(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    ).data.firebaseUid
      == request.auth.uid

    && getAfter(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    ).data.accountActivated
      == true;


  /*
   * Le mapping devient immuable pour
   * l'utilisateur lui-même.
   */
  allow update, delete:
    if isAdmin();

}


    /*
     * ============================================================
     * USERS
     * ============================================================
     */

    match /users/{userId} {

  /*
   * ============================================================
   * GET
   * ============================================================
   *
   * Autorisé pour :
   *
   * - son propre profil après activation
   * - le profil ciblé pendant le bootstrap d'activation
   * - un administrateur
   */

  allow get:
    if (
      hasAuthLink()
      && currentUserId() == userId
    )
    || isActivationProfile(userId)
    || isAdmin();


  /*
   * ============================================================
   * LIST
   * ============================================================
   *
   * Nécessaire pour l'écran Administration > Utilisateurs.
   */

  allow list:
    if isAdmin();


  /*
   * ============================================================
   * CREATE
   * ============================================================
   *
   * Création métier réservée à l'administrateur.
   */

  allow create:
    if isAdmin()

    /*
     * Structure obligatoire.
     */
    && request.resource.data.keys().hasOnly([
      "firebaseUid",
      "licenseNumber",
      "firstname",
      "lastname",
      "email",
      "seasonId",
      "accountActivated",
      "roles",
      "status",
      "createdAt",
      "updatedAt",
      "lastLoginAt"
    ])

    && request.resource.data.licenseNumber
      is string

    && request.resource.data.firstname
      is string

    && request.resource.data.lastname
      is string

    && request.resource.data.email
      is string

    && request.resource.data.seasonId
      is string

    /*
     * Un compte créé par l'administration
     * n'est pas encore lié à Firebase Auth.
     */
    && request.resource.data.firebaseUid
      == null

    && request.resource.data.accountActivated
      == false

    && request.resource.data.lastLoginAt
      == null

    && request.resource.data.status
      == "ACTIVE"

    /*
     * Les trois rôles doivent être présents.
     */
    && request.resource.data.roles.keys().hasOnly([
      "administrator",
      "manager",
      "player"
    ])

    && request.resource.data.roles.administrator
      is bool

    && request.resource.data.roles.manager
      is bool

    && request.resource.data.roles.player
      is bool

    /*
     * Au moins un rôle.
     */
    && (
      request.resource.data.roles.administrator
        == true
      ||
      request.resource.data.roles.manager
        == true
      ||
      request.resource.data.roles.player
        == true
    )

    /*
     * Le batch doit également créer l'index
     * activation-licenses correspondant.
     */
    && getAfter(
      /databases/$(database)/documents/activation-licenses/$(request.resource.data.licenseNumber)
    ).data.userId
      == userId;


  /*
   * ============================================================
   * UPDATE
   * ============================================================
   */

  allow update:
 if
    /*
     * ----------------------------------------------------------
     * Cas 1 : administration
     * ----------------------------------------------------------
     */

    (
      isAdmin()

      /*
       * Le numéro de licence reste immuable
       * dans cette première version.
       */
      && request.resource.data.licenseNumber
        == resource.data.licenseNumber

      /*
       * Le lien Firebase ne doit pas être manipulé
       * depuis l'écran d'administration.
       */
      && request.resource.data.firebaseUid
        == resource.data.firebaseUid

      && request.resource.data.accountActivated
        == resource.data.accountActivated

      && request.resource.data.createdAt
        == resource.data.createdAt

      && request.resource.data.lastLoginAt
        == resource.data.lastLoginAt

      /*
       * Statuts métier autorisés.
       */
      && request.resource.data.status in [
        "ACTIVE",
        "BLOCKED"
      
      ]

      /*
       * Structure des rôles.
       */
      && request.resource.data.roles.keys().hasOnly([
  "administrator",
  "manager",
  "player"
])

/*
 * Un administrateur ne peut pas se retirer
 * lui-même le rôle administrateur ni se bloquer.
 */
&& (
  userId != currentUserId()
  ||
  (
    request.resource.data.roles.administrator == true
    &&
    request.resource.data.status == "ACTIVE"
  )
)

      && request.resource.data.roles.administrator
        is bool

      && request.resource.data.roles.manager
        is bool

      && request.resource.data.roles.player
        is bool

      && (
        request.resource.data.roles.administrator
          == true
        ||
        request.resource.data.roles.manager
          == true
        ||
        request.resource.data.roles.player
          == true
      )

      /*
       * Seuls ces champs peuvent être modifiés
       * par l'administration.
       */
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "firstname",
          "lastname",
          "email",
          "seasonId",
          "roles",
          "status",
          "updatedAt"
        ])
    )


    /*
     * ----------------------------------------------------------
     * Cas 2 : activation initiale
     * ----------------------------------------------------------
     */

    || (

      isActivationProfile(userId)

      /*
       * Association au compte Firebase connecté.
       */
      && request.resource.data.firebaseUid
        == request.auth.uid

      && request.resource.data.accountActivated
        == true

      /*
       * Seuls les champs techniques d'activation
       * peuvent changer.
       */
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "firebaseUid",
          "email",
          "accountActivated",
          "lastLoginAt",
          "updatedAt"
        ])

      /*
       * Protection des données métier.
       */
      && request.resource.data.licenseNumber
        == resource.data.licenseNumber

      && request.resource.data.roles
        == resource.data.roles

      && request.resource.data.status
        == resource.data.status

      && request.resource.data.firstname
        == resource.data.firstname

      && request.resource.data.lastname
        == resource.data.lastname

      && request.resource.data.seasonId
        == resource.data.seasonId

    );


  /*
   * ============================================================
   * DELETE
   * ============================================================
   *
   * On bloque volontairement la suppression physique.
   *
   * Un utilisateur est désactivé avec :
   *
   * status = BLOCKED
   */

  allow delete:
    if false;

}

    /*
     * ============================================================
     * VENUES
     * ============================================================
     */

    match /venues/{venueId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }


    /*
     * ============================================================
     * VENUE SCHEDULES
     * ============================================================
     */

    match /venue-schedules/{scheduleId} {

      allow read:
        if hasActiveProfile();

      allow create:
        if hasActiveProfile()
        && canManageVenue(
          request.resource.data.venueId
        );

      allow update:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        )
        && request.resource.data.venueId
          == resource.data.venueId;

      allow delete:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        );
    }


    /*
     * ============================================================
     * VENUE CLOSURES
     * ============================================================
     */

    match /venue-closures/{closureId} {

      allow read:
        if hasActiveProfile();

      allow create:
        if hasActiveProfile()
        && canManageVenue(
          request.resource.data.venueId
        );

      allow update:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        )
        && request.resource.data.venueId
          == resource.data.venueId;

      allow delete:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        );
    }


    /*
     * ============================================================
     * AVAILABILITY RULES
     * ============================================================
     */

    match /availabilityRules/{ruleId} {

      allow read:
        if hasActiveProfile();

      allow create:
        if hasActiveProfile()
        && canManageVenue(
          request.resource.data.venueId
        );

      allow update:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        )
        && request.resource.data.venueId
          == resource.data.venueId;

      allow delete:
        if hasActiveProfile()
        && canManageVenue(
          resource.data.venueId
        );
    }


    /*
     * ============================================================
     * UNAVAILABLE SLOTS
     * ============================================================
     */

    match /unavailableSlots/{slotId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }


    /*
     * ============================================================
     * RESERVATIONS
     * ============================================================
     */

    match /reservations/{reservationId} {

      /*
       * Le planning et les écrans de validation ont besoin
       * de consulter les réservations.
       */
      allow read:
        if hasActiveProfile();


      /*
       * ----------------------------------------------------------
       * CREATION
       * ----------------------------------------------------------
       */

      allow create:
        if hasActiveProfile()

        /*
         * L'utilisateur doit être capitaine ou joueur
         * d'une des deux inscriptions du match.
         */
        && canPlanMatch(
          request.resource.data.matchId
        )

        /*
         * Impossible de créer une réservation
         * au nom d'un autre utilisateur.
         */
        && request.resource.data.createdByUserId
          == currentUserId()

        /*
         * Une nouvelle réservation commence
         * obligatoirement en PENDING.
         */
        && request.resource.data.status
          == "PENDING"

        /*
         * Le venueId est obligatoire.
         */
        && request.resource.data.venueId is string

        /*
         * L'établissement doit réellement exister.
         */
        && exists(
          /databases/$(database)/documents/venues/$(request.resource.data.venueId)
        )

        /*
         * Les champs de validation doivent être
         * vierges lors de la création.
         */
        && request.resource.data.validatedByUserId == null
        && request.resource.data.validatedAt == null

        && request.resource.data.rejectedByUserId == null
        && request.resource.data.rejectedAt == null

        && request.resource.data.cancelledByUserId == null
        && request.resource.data.cancelledAt == null;


      /*
       * ----------------------------------------------------------
       * UPDATE
       * ----------------------------------------------------------
       */

      allow update:
        if isAdmin()

        /*
         * --------------------------------------------------------
         * VALIDATION / REJET PAR LE GERANT
         * --------------------------------------------------------
         */
        || (

          /*
           * Le gérant doit gérer l'établissement
           * de la réservation.
           */
          canManageVenue(
            resource.data.venueId
          )

          /*
           * Impossible de déplacer la réservation
           * vers un autre établissement.
           */
          && request.resource.data.venueId
            == resource.data.venueId

          /*
           * Impossible de changer de match.
           */
          && request.resource.data.matchId
            == resource.data.matchId

          /*
           * Impossible de changer l'auteur.
           */
          && request.resource.data.createdByUserId
            == resource.data.createdByUserId

          /*
           * Seuls les champs de validation/rejet
           * peuvent changer.
           */
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "validatedByUserId",
              "validatedAt",
              "rejectedByUserId",
              "rejectedAt",
              "validationComment"
            ])

          /*
           * Le gérant ne traite qu'une réservation
           * actuellement PENDING.
           */
          && resource.data.status
            == "PENDING"

          /*
           * Deux destinations possibles :
           *
           * PENDING -> CONFIRMED
           * PENDING -> REJECTED
           */
          && request.resource.data.status in [
            "CONFIRMED",
            "REJECTED"
          ]

          /*
           * Si CONFIRMED :
           * l'utilisateur ayant validé doit être
           * exactement l'utilisateur connecté.
           */
          && (
            request.resource.data.status != "CONFIRMED"
            || request.resource.data.validatedByUserId
              == currentUserId()
          )

          /*
           * Si REJECTED :
           * l'utilisateur ayant rejeté doit être
           * exactement l'utilisateur connecté.
           */
          && (
            request.resource.data.status != "REJECTED"
            || request.resource.data.rejectedByUserId
              == currentUserId()
          )
        )

        /*
         * --------------------------------------------------------
         * ANNULATION PAR UN MEMBRE DU MATCH
         * --------------------------------------------------------
         */
        || (

          hasActiveProfile()

          /*
           * Capitaine ou joueur d'une des deux
           * inscriptions du match.
           */
          && canPlanMatch(
            resource.data.matchId
          )

          /*
           * Passage obligatoire vers CANCELLED.
           */
          && request.resource.data.status
            == "CANCELLED"

          /*
           * On trace le véritable utilisateur connecté.
           */
          && request.resource.data.cancelledByUserId
            == currentUserId()

          /*
           * Seuls les champs d'annulation
           * peuvent changer.
           */
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "cancelledByUserId",
              "cancelledAt"
            ])
        );


      /*
       * Pas de suppression physique par un joueur
       * ou un gérant.
       */
      allow delete:
        if isAdmin();
    }


    /*
 * ============================================================
 * MATCHES
 * ============================================================
 */

match /matches/{matchId} {

  /*
   * Les matchs sont nécessaires aux joueurs,
   * gérants et administrateurs.
   */
  allow read:
    if hasActiveProfile();

  /*
   * La création/suppression du calendrier
   * reste une opération d'administration.
   */
  allow create, delete:
    if isAdmin();

  /*
   * Modification :
   *
   * 1. administrateur
   * 2. planification par capitaine/joueur
   * 3. validation par le gérant du bar
   */
  allow update:
    if isAdmin()

    /*
 * --------------------------------------------------------
 * NOT_PLANNED -> PENDING
 *
 * Un capitaine/joueur vient de créer une réservation.
 * --------------------------------------------------------
 */
|| (

  /*
   * L'utilisateur doit appartenir au match.
   */
  canPlanMatch(matchId)

  /*
   * Transition autorisée.
   */
  && resource.data.status
    == "NOT_PLANNED"

  && request.resource.data.status
    == "PENDING"

  /*
   * Le match ne doit actuellement avoir
   * aucune réservation associée.
   */
  && resource.data.plannedReservationId
    == null

  /*
   * Une réservation doit maintenant être associée.
   */
  && request.resource.data.plannedReservationId
    is string

  /*
   * Seuls ces deux champs peuvent changer.
   */
  && request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "status",
      "plannedReservationId"
    ])

  /*
   * La réservation doit exister.
   */
  && exists(
    /databases/$(database)/documents/reservations/$(request.resource.data.plannedReservationId)
  )

  /*
   * Elle doit correspondre exactement à ce match.
   */
  && get(
    /databases/$(database)/documents/reservations/$(request.resource.data.plannedReservationId)
  ).data.matchId
    == matchId

  /*
   * Elle doit être en attente.
   */
  && get(
    /databases/$(database)/documents/reservations/$(request.resource.data.plannedReservationId)
  ).data.status
    == "PENDING"

  /*
   * Et avoir été créée par l'utilisateur métier connecté.
   */
  && get(
    /databases/$(database)/documents/reservations/$(request.resource.data.plannedReservationId)
  ).data.createdByUserId
    == currentUserId()
)

    /*
 * --------------------------------------------------------
 * PENDING / PLANNED -> NOT_PLANNED
 *
 * Annulation ou retrait d'une réservation.
 *
 * - PENDING :
 *   annulation avant validation
 *
 * - PLANNED :
 *   annulation après validation par le gérant
 * --------------------------------------------------------
 */
|| (
  canPlanMatch(matchId)

  && resource.data.status in [
    "PENDING",
    "PLANNED"
  ]

  && request.resource.data.status
    == "NOT_PLANNED"

  && request.resource.data.plannedReservationId
    == null

  /*
   * Une réservation doit réellement être
   * associée au match avant son retrait.
   */
  && resource.data.plannedReservationId
    is string

  /*
   * La réservation associée doit maintenant
   * être annulée ou refusée.
   */
  && get(
    /databases/$(database)/documents/reservations/$(resource.data.plannedReservationId)
  ).data.status in [
    "CANCELLED",
    "REJECTED"
  ]

  /*
   * Seuls le statut et l'association
   * à la réservation peuvent changer.
   */
  && request.resource.data
    .diff(resource.data)
    .affectedKeys()
    .hasOnly([
      "status",
      "plannedReservationId"
    ])
)

    /*
     * --------------------------------------------------------
     * PENDING -> PLANNED
     *
     * Validation par le gérant du bar.
     * --------------------------------------------------------
     */
    || (
      resource.data.status
        == "PENDING"

      && request.resource.data.status
        == "PLANNED"

      /*
       * La réservation reste la même.
       */
      && request.resource.data.plannedReservationId
        == resource.data.plannedReservationId

      /*
       * Le gérant doit gérer le bar de
       * cette réservation.
       */
      && canManageVenue(
        get(
          /databases/$(database)/documents/reservations/$(resource.data.plannedReservationId)
        ).data.venueId
      )

      /*
       * Seul le statut peut changer.
       */
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "status"
        ])
    );
}


    /*
     * ============================================================
     * REGISTRATIONS
     * ============================================================
     */

    match /registrations/{registrationId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }


    /*
     * ============================================================
     * MATCHDAYS
     * ============================================================
     */

    match /matchdays/{matchDayId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }


    /*
     * ============================================================
     * SEASONS
     * ============================================================
     */

    match /seasons/{seasonId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }


    /*
     * ============================================================
     * SYSTEM
     * ============================================================
     */

    match /system/{documentId} {

      allow read:
        if hasActiveProfile();

      allow create, update, delete:
        if isAdmin();
    }

    /*
 * ============================================================
 * COMPETITIONS
 * ============================================================
 */

match /competitions/{competitionId} {

  /*
   * Les compétitions sont nécessaires aux utilisateurs
   * actifs pour le fonctionnement du championnat.
   */
  allow read:
    if hasActiveProfile();

  /*
   * L'administration du référentiel reste réservée
   * aux administrateurs.
   */
  allow create:
    if isAdmin()
    && request.resource.data.seasonId is string
    && request.resource.data.name is string
    && request.resource.data.mode in [
      "INDIVIDUAL",
      "DOUBLES",
      "TEAM"
    ]
    && request.resource.data.active is bool;

  allow update:
    if isAdmin()

    /*
     * Une compétition ne change pas de saison.
     */
    && request.resource.data.seasonId
      == resource.data.seasonId

    && request.resource.data.name is string

    && request.resource.data.mode in [
      "INDIVIDUAL",
      "DOUBLES",
      "TEAM"
    ]

    && request.resource.data.active is bool

    && request.resource.data
      .diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "name",
        "mode",
        "active",
        "updatedAt"
      ]);

  /*
   * Pas de suppression physique.
   */
  allow delete:
    if false;

}


    /*
     * ============================================================
     * DENY BY DEFAULT
     * ============================================================
     */

    match /{document=**} {

      allow read, write:
        if false;
    }

  }

}       